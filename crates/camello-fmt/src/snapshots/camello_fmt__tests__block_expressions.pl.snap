---
source: crates/camello-fmt/src/tests.rs
expression: format(&source)
---
my $value = $flag ? do {
    $x + $y;
} : 0;

my $result = $condition ? do {
    compute();
    $x * 2;
} : do {
    fallback();
};

grep {
    /re/;
} @list;

my @filtered = grep {
    $_->is_valid;
} @items;

map {
    $_ * 2;
} @numbers;

my @transformed = map {
    transform($_);
} @data;

my $code = sub {
    my $x = shift;
    return $x * 2;
};

my @result = sort {
    $a <=> $b;
} @values;

my $callback = sub {
    process(@_);
};

my $chained = try {
    risky();
} catch {
    fallback();
};
