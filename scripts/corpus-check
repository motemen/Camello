#!/usr/bin/env bash
#
# Run camello over a real Perl corpus.
#
#   scripts/corpus-check                  every .pm below @INC
#   scripts/corpus-check <path>...        the given files or directories
#   scripts/corpus-check --limit 200      a prefix of the corpus, evenly spread
#   scripts/corpus-check --jobs 8         worker count (default: the binary's)
#   scripts/corpus-check --list           print the corpus and exit
#   scripts/corpus-check --no-perl        the invariants only, without the oracle
#   scripts/corpus-check --check          `camello check` over the corpus instead
#
# ── What is here, and what is not ─────────────────────────────────────────────
#
# The questions belong to the binary. `dev check` asks the parser and formatter
# invariants — the tree's normal form, comment and verbatim preservation,
# semantics, idempotency — and `dev perl-deparse` asks perl whether it reads the
# output as the program the input was. Both walk directories, both run one file
# per core, and both separate a check they could not answer from one that
# failed, with the reasons counted and the messages grouped.
#
# `--check` asks the checker (docs/typecheck.md) instead. The
# bar there is *zero errors*, not because CPAN is well-typed but because a
# checker that cannot stay silent on code it was told nothing about is broken.
# Warnings are counted and reported, and the count going up is a regression to
# look at.
#
# This script is the corpus. Selecting one is the part the binary has no opinion
# about: the `.pm` files below @INC, deduplicated because @INC entries nest, and
# optionally sampled down to something that finishes while you watch it.
#
# Fixtures exercise written-down cases; a corpus is code that was written to get
# a job done. It is the real-corpus half of the validation strategy in
# docs/architecture.md.
#
# ── perl runs your corpus ─────────────────────────────────────────────────────
#
# `dev perl-deparse` shells out to `perl -c`, which executes the BEGIN blocks of
# the file it is pointed at — arbitrary code out of somebody's distribution.
# That is why the binary keeps it behind its own command; here it is the point
# of the run, and `--no-perl` is how to decline it.
#
# A corpus checked away from the tree it was installed in answers `Can't locate
# ... in @INC` to almost everything. perl inherits this shell's environment, so
# PERL5LIB=<the tree's lib> is the fix, and the binary says so itself.

set -uo pipefail

base_dir="$(cd "$(dirname "$0")/.." && pwd)"

limit=0
list_only=0
run_perl=1
mode=invariants
paths=()
forward=()

while [ $# -gt 0 ]; do
  case $1 in
    --jobs)    forward+=(--jobs "$2"); shift 2 ;;
    --limit)   limit=$2; shift 2 ;;
    --list)    list_only=1; shift ;;
    --no-perl) run_perl=0; shift ;;
    --check)     mode=check; shift ;;
    --help|-h)
      sed -n '2,48p' "$0" | sed 's/^#\{0,1\} \{0,1\}//'
      exit 0 ;;
    *) paths+=("$1"); shift ;;
  esac
done

collect() {
  if [ ${#paths[@]} -gt 0 ]; then
    for path in "${paths[@]}"; do
      if [ -d "$path" ]; then
        find "$path" \( -name '*.pm' -o -name '*.pl' -o -name '*.t' \) 2>/dev/null
      else
        printf '%s\n' "$path"
      fi
    done
    return
  fi
  # `.` and relative entries in @INC would resolve against this repository, and
  # the repository is not the corpus.
  perl -e 'print "$_\n" for grep { !ref && m{^/} && -d } @INC' \
    | while read -r dir; do find "$dir" -name '*.pm' 2>/dev/null; done
}

# `sort -u`, not just `sort`: @INC entries nest — `site_perl/5.40.0/darwin-2level`
# lives inside `site_perl/5.40.0` — so a plain walk of each would ask about the
# same file twice and count it twice.
mapfile -t corpus < <(collect | sort -u)

if [ "$limit" -gt 0 ] && [ "${#corpus[@]}" -gt "$limit" ]; then
  # Every nth file rather than the first n: the corpus is sorted by path, so a
  # prefix would be one distribution's worth of one namespace.
  stride=$(( (${#corpus[@]} + limit - 1) / limit ))
  sampled=()
  for ((i = 0; i < ${#corpus[@]}; i += stride)); do
    sampled+=("${corpus[i]}")
  done
  corpus=("${sampled[@]}")
fi

if [ ${#corpus[@]} -eq 0 ]; then
  echo "corpus-check: no files found" >&2
  exit 1
fi

if [ "$list_only" -eq 1 ]; then
  printf '%s\n' "${corpus[@]}"
  exit 0
fi

( cd "$base_dir" && cargo build --quiet --release ) || exit 1
camello="$base_dir/target/release/camello"

status=0

if [ "$mode" != invariants ]; then
  echo "==== $mode: ${#corpus[@]} files"
  # The diagnostics go to stdout and the tally to stderr, so a run that says
  # nothing on stdout is a run with nothing to say.
  "$camello" "$mode" "${forward[@]}" "${corpus[@]}" || status=1
  exit "$status"
fi

echo "==== dev check: ${#corpus[@]} files"
"$camello" dev check "${forward[@]}" "${corpus[@]}" || status=1

if [ "$run_perl" -eq 1 ]; then
  echo
  echo "==== dev perl-deparse: ${#corpus[@]} files"
  "$camello" dev perl-deparse "${forward[@]}" "${corpus[@]}" || status=1
fi

exit "$status"
