#!/bin/bash

set -euo pipefail

base_dir="$(cd "$(dirname "$0")/.." && pwd)"

( cd "$base_dir" && cargo build )

# Takes a list of directories or archive files as arguments, runs $base_dir/target/debug/camello dump on them, and displays success rate.
# Additionally, when processing directories, if .tar.gz/.tgz/.zip files are found, they are extracted into temporary directories
# and processed recursively as directories.

total=0
success=0
failed_files=()

# Function to extract archive to temporary directory
extract_archive() {
	local archive="$1"
	local temp_dir

	temp_dir=$(mktemp -d)

	case "$archive" in
		*.tar.gz|*.tgz)
			# echo "Extracting tar.gz archive: $archive to $temp_dir" >&2
			tar -xzf "$archive" -C "$temp_dir"
			;;
		*.zip)
			# echo "Extracting zip archive: $archive to $temp_dir" >&2
			unzip -q "$archive" -d "$temp_dir"
			;;
		*)
			echo "Unsupported archive format: $archive" >&2
			rm -rf "$temp_dir"
			return 1
			;;
	esac

	echo "$temp_dir"
}

# Function to process an archive: extract then process as a directory
process_archive() {
	local archive="$1"
	local temp_dir
	local archive_failed=0

	temp_dir=$(extract_archive "$archive") || return 1
	if [ -n "$temp_dir" ] && [ -d "$temp_dir" ]; then
		process_directory "$temp_dir" || archive_failed=1

		# Clean up temp directory only if all processing succeeded
		if [ "$archive_failed" -eq 0 ]; then
			rm -rf "$temp_dir"
		else
			echo "Some files failed to process. Keeping temporary directory: $temp_dir" >&2
		fi
	fi

	return "$archive_failed"
}

# Function to process a directory
# Returns 1 if any file failed to process, 0 otherwise
process_directory() {
	local dir="$1"
	local dir_failed=0

	while IFS= read -r file; do
		if [ -f "$file" ]; then
			case "$file" in
				*.tar.gz|*.tgz|*.zip)
					# Found an archive inside the directory: extract and recurse
					process_archive "$file" || dir_failed=1
					;;
				*.pm|*.t)
					((total++))
					encoding=$(nkf -g "$file")
					if [ "$encoding" = "unknown" ] || [ "$encoding" = "UTF-8" ] || [ "$encoding" = "ASCII" ] || [ "$encoding" = "BINARY" ]; then
						encoding_flag=""
					else
						encoding_flag="--encoding $encoding"
					fi
					if "$base_dir/target/debug/camello" dump $encoding_flag -q "$file"; then
						((success++))
						/bin/echo -n "." >&2
					else
						failed_files+=("$file")
						/bin/echo -n "F" >&2
						dir_failed=1
					fi
					;;
				*)
					# Ignore other files
					;;
			esac
		fi
	done < <(find "$dir" -type f \( -name "*.pm" -o -name "*.t" -o -name "*.tar.gz" -o -name "*.tgz" -o -name "*.zip" \))

	return "$dir_failed"
}

for target in "$@"; do
	if [ -d "$target" ]; then
		process_directory "$target"
	elif [ -f "$target" ]; then
		case "$target" in
			*.tar.gz|*.tgz|*.zip)
                process_archive "$target" || true
				;;
			*)
				echo "Unsupported file type: $target (expected directory or .tar.gz/.tgz/.zip archive)" >&2
				;;
		esac
	else
		echo "Target not found or not accessible: $target" >&2
	fi
done

echo >&2

if [ "$total" -eq 0 ]; then
	rate=0
else
	rate=$((success * 100 / total))
fi

if [ ${#failed_files[@]} -gt 0 ]; then
	echo "Failed files:" >&2
	for file in "${failed_files[@]}"; do
		echo "$file" >&2
	done
fi

echo
echo "Success rate: $success / $total ($rate%)"
