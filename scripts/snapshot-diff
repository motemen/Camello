#!/bin/bash
#
# Compare the formatter snapshots against the ones from before the redesign
# switch-over, so the behaviour changes it introduced stay reviewable.
#
#   scripts/snapshot-diff              list the fixtures whose output changed
#   scripts/snapshot-diff <fixture>    show one fixture's diff
#   BEFORE=<rev> scripts/snapshot-diff compare against a different revision
#
# The classification of these diffs is in
# notes/2026-07-28-redesign-snapshot-classification.md.

set -euo pipefail

# The commit that deleted the old stack; its parent still has the old snapshots.
BEFORE=${BEFORE:-22fbf18~1}

if ! git rev-parse --quiet --verify "$BEFORE^{commit}" >/dev/null; then
  echo "revision not found: $BEFORE" >&2
  exit 1
fi

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
mkdir -p "$work/old" "$work/new"

# insta snapshots start with a YAML header terminated by a `---` line.
strip_header() { sed '1,/^---$/d'; }

git ls-tree -r --name-only "$BEFORE" \
  | grep -E '^src/formatter/snapshots/camello__formatter__tests__.*\.snap$' \
  | while read -r path; do
      name=$(basename "$path" .snap)
      git show "$BEFORE:$path" | strip_header > "$work/old/${name#camello__formatter__tests__}"
    done

for path in src/fmt/snapshots/camello__fmt__tests__*.snap; do
  name=$(basename "$path" .snap)
  strip_header < "$path" > "$work/new/${name#camello__fmt__tests__}"
done

if [ $# -ge 1 ]; then
  fixture=$1
  if [ ! -f "$work/old/$fixture" ]; then
    echo "no snapshot from $BEFORE for: $fixture" >&2
    exit 1
  fi
  diff -u --label "$BEFORE/$fixture" --label "HEAD/$fixture" \
    "$work/old/$fixture" "$work/new/$fixture"
  exit 0
fi

same=0
changed=0
for path in "$work"/new/*; do
  fixture=$(basename "$path")
  [ -f "$work/old/$fixture" ] || continue
  if diff -q "$work/old/$fixture" "$work/new/$fixture" >/dev/null; then
    same=$((same + 1))
  else
    changed=$((changed + 1))
    # `diff` exits non-zero when the files differ, which is the normal case
    # here; with `pipefail` that would abort the loop.
    lines=$(diff "$work/old/$fixture" "$work/new/$fixture" | grep -c '^[<>]' || true)
    printf '%4d  %s\n' "$lines" "$fixture"
  fi
done > "$work/list"

sort -rn "$work/list"
printf -- '---- unchanged %d, changed %d\n' "$same" "$changed"
