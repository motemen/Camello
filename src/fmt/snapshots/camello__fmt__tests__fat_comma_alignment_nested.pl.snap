---
source: src/fmt/tests.rs
expression: format(&source)
---
sub nested_fat_commas {
    HTTP::Response->new(
        code => 401,
        message => 'Authorization required',
        headers => {
            Content_Type => 'text/plain',
        },
    );

    my %hash = (
        first  => 1,
        second => {
            inner_key => 2,
        },
        third => 3,
    );

    # Multi-line nested hash with alignment
    $db->query(
        sql => q[],
        bind => {
            x   => 1,
            yyy => 2,
        },
    );

    # Deeper nesting
    func(
        a => 1,
        b => {
            xx  => 10,
            yyy => 20,
        },
        c => 3,
    );
}
