---
source: src/fmt/tests.rs
expression: format(&source)
---
# Trailing comment after operator should preserve continuation indent
my $x = 1 + # comment
    2;

my $y = 10 * # another comment
    3;

my $result = $foo + # trailing comment
    $bar;

# Multiple operators with trailing comments
my $complex = $a + # first
    $b * # second
    $c;

# Assignment operator with trailing comment
my $val = # comment after equals
    123;

# Chained operations with comments
my $chain = $first + # add first
    $second - # subtract second
    $third;   # final value
