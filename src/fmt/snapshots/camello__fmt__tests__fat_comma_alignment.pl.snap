# `func` is declared so perl reads the calls below as calls; camello has no
# symbol table and reads them the same either way.
sub func;

use constant ABC => 1; # comment
use constant D   => 'a';

use constant A   => 1;
use constant FOO => 99;

use Module (
    X   => 1,
    YYY => 2,
);

func(
    a => 1,
    bbb => 2,
);

func
    a => 1,
    bbb => 2;
