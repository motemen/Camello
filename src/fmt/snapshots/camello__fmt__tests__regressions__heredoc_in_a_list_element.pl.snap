# A heredoc marker inside a bracketed list element: `[ <<'X', 1 ],`. The
# element's brackets close on the marker's own line, so the body starts on the
# next one — a different nesting from heredoc_inside_a_broken_group, where the
# group the marker sits in is still open when the body arrives.
my @cases = (
    [ q<one>, 0 ],
    [ <<'__A__', 1 ],
    alpha
beta
     __A__

    [ q<two>, 1 ],
);
