---
source: src/fmt/tests.rs
expression: format(&source)
---
# Subroutine attributes tests

# Simple attribute without arguments
sub foo : method {  }

# Attribute with simple argument
sub f : prototype($) {  }

# Multiple attributes
sub fnord (&\%) : switch(10,foo(7,3)) : expensive {  }

# Attribute with nested parentheses
sub complex : attr(foo(bar(baz))) {  }

# Multiple attributes on separate lines (should be preserved)
sub multi
    : lvalue
    : method {  }

# Anonymous sub with attributes
my $sub = sub : lvalue {  };

# Forward declaration with attributes
sub forward_decl : method;
