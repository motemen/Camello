---
source: src/fmt/tests.rs
expression: format(&source)
---
# A package block written with a trailing `;`. The semicolon belongs to the
# `}` that precedes it, but it is put on a line of its own.
use Test2::V0;

sub t {
    package Foo::Bar {
        use parent -norequire, 'Foo::Base';
    }
    ;

    is 1, 1;
}
