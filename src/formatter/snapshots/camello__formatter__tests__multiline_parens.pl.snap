# Test multiline parentheses in various contexts

# Array assignment
@a = (
    1,
    2,
);

# use statement with arguments

use A (
    x => 1
);

# Hash assignment

%hash = (
    key => 'value'
);

# Subroutine call
my $result = some_func(
    arg1,
    arg2
);

# Nested parentheses
my $x = (
    (
        1 + 2
    ) * 3
);

# Mixed: no newline after opening paren (should not reformat)
my @list = (1, 2,
    3, 4);
