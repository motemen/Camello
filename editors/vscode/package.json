{
  "name": "camello",
  "displayName": "Camello",
  "description": "Perl diagnostics, hover, method completion and formatting, from the camello language server",
  "version": "0.2.1",
  "publisher": "camello",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/motemen/Camello.git",
    "directory": "editors/vscode"
  },
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "activationEvents": [
    "onLanguage:perl",
    "workspaceContains:**/camello.toml",
    "onCommand:camello.checkWorkspace"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Camello",
      "properties": {
        "camello.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `camello` binary. Empty means whatever is on `PATH`, and if there is nothing there either, the server for this extension's version is downloaded from its GitHub release."
        },
        "camello.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Log the traffic between the editor and the server."
        }
      }
    },
    "commands": [
      {
        "command": "camello.restartServer",
        "title": "Camello: Restart Language Server"
      },
      {
        "command": "camello.checkWorkspace",
        "title": "Camello: Check Workspace"
      }
    ],
    "taskDefinitions": [
      {
        "type": "camello",
        "required": [],
        "properties": {
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Extra arguments for `camello check`, such as `--min-severity warning`.",
            "default": []
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "camello",
        "owner": "camello",
        "source": "camello",
        "fileLocation": [
          "autoDetect",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+):\\s+(error|warning|info):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  }
}
